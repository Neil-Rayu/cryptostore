diff --git a/hw/misc/trace-events b/hw/misc/trace-events
index c9a868b..92f0c0f 100644
--- a/hw/misc/trace-events
+++ b/hw/misc/trace-events
@@ -442,3 +442,19 @@ iommu_testdev_dma_read(uint64_t gva, uint32_t len) "gva=0x%" PRIx64 " len=%u"
 iommu_testdev_dma_verify(uint32_t expected, uint32_t actual) "expected=0x%x actual=0x%x"
 iommu_testdev_dma_result(uint32_t result) "DMA completed result=0x%x"
 iommu_testdev_dma_armed(bool armed) "armed=%d"
+
+# cryptostore.c
+cryptostore_mmio_read(const char *dev, uint64_t addr, const char *reg, uint64_t val) "%s: read  0x%03" PRIx64 " %s -> 0x%" PRIx64
+cryptostore_mmio_write(const char *dev, uint64_t addr, const char *reg, uint64_t val) "%s: write 0x%03" PRIx64 " %s <- 0x%" PRIx64
+cryptostore_window(const char *dev, const char *win, bool write, uint64_t off, unsigned size) "%s: %s window write=%d offset 0x%" PRIx64 " size %u (value not traced)"
+cryptostore_cmd_start(const char *dev, uint32_t cmd, const char *state) "%s: command 0x%x started in %s"
+cryptostore_cmd_done(const char *dev, uint32_t cmd, uint32_t result, const char *state) "%s: command 0x%x done result 0x%x state %s"
+cryptostore_state(const char *dev, const char *from, const char *to) "%s: state %s -> %s"
+cryptostore_irq(const char *dev, const char *how, uint32_t int_status, uint32_t int_enable) "%s: irq %s int_status 0x%x int_enable 0x%x"
+cryptostore_reset(const char *dev, const char *kind) "%s: %s: in-flight work cancelled, keys zeroized"
+cryptostore_kdf_dispatch(const char *dev, int kind) "%s: KDF job %d dispatched to the worker"
+cryptostore_io(const char *dev, const char *op, uint64_t lba, uint32_t count) "%s: %s lba %" PRIu64 " count %u"
+cryptostore_fault(const char *dev) "%s: fault response"
+cryptostore_fault_hook(const char *dev, const char *target) "%s: test hook fired: %s"
+
+# cryptorecovery.c
+cryptorecovery_mmio(const char *dev, bool write, uint64_t addr, uint64_t val) "%s: write=%d 0x%03" PRIx64 " 0x%" PRIx64
+cryptorecovery_event(const char *dev, const char *what) "%s: %s"
